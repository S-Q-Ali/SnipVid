# Site URL for canonical URLs, sitemap, and robots.txt
# (set to your SnipVid production domain; placeholder below)
NEXT_PUBLIC_SITE_URL=https://snipvid.example.com

# yt-dlp binary path (optional - defaults to system PATH)
# YTDLP_PATH=/usr/bin/yt-dlp

# Optional Instagram session (Netscape cookies.txt, e.g. from a cookies.txt
# exporter or a yt-dlp --cookies dump).
#
# Instagram no longer serves most content to unsigned clients, so anonymous
# downloads are unreliable. Point this at a cookie file to make them work.
# Leave unset to run anonymously.
#
# Treat the file as a secret: keep it out of git and out of the deploy image.
# /api/health reports only whether a session is usable, never the path.
# INSTAGRAM_COOKIES_FILE=/run/secrets/instagram-cookies.txt

# Gating flag: set to false to disable the Instagram download/analyze routes.
# Anything other than "false" (including unset) leaves them enabled.
INSTAGRAM_ENABLED=true

# Where downloaded media is written and served from (optional).
# Defaults to ./storage/temp inside the project, which is not writable on
# every host. Point this at a private, writable directory in production and
# make sure only this app reads it: a shared path lets one instance delete
# another instance's files.
# STORAGE_TEMP_DIR=/var/lib/snipvid/temp

# Rate limiting and client identity.
#
# SnipVid only reads the client address from x-forwarded-for / x-real-ip when
# this is exactly "true", because both headers are client-controlled and are
# otherwise trivial to spoof. Set it ONLY when the app sits behind a proxy that
# overwrites or appends to those headers.
#
# Leave it unset and every request shares one rate-limit bucket, which is
# harsher on real users but cannot be bypassed.
# TRUST_PROXY=true
